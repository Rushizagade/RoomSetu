# ──────────────────────────────────────────────
# RoomSetu Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ──────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── JWT ───────────────────────────────────────
# REQUIRED in production — must be a long random secret
JWT_SECRET=roomsetu-super-secure-production-jwt-key-949f4827
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1d

# ── CORS ──────────────────────────────────────
# In production, set this to your actual frontend domain
CORS_ORIGIN=*

# ── Request Limits ────────────────────────────
MAX_JSON_SIZE=15mb

# ── OTP ───────────────────────────────────────
# How long (minutes) an OTP is valid before expiry
OTP_EXPIRY_MINUTES=10

# ── Logging ───────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info

# ── Google Maps Platform ──────────────────────
# Required for Places Autocomplete and Maps JS API on the frontend
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Google Generative AI (Gemini) ─────────────
# AI Studio injects this automatically at runtime
GEMINI_API_KEY=

# ── App URL ───────────────────────────────────
# Injected by AI Studio / Cloud Run at runtime
APP_URL=http://localhost:3000
