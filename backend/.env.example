# Copy this file to .env and adjust values as needed
NODE_ENV=development
PORT=3000
JWT_SECRET=roomsetu-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1d
CORS_ORIGIN=*
MAX_JSON_SIZE=15mb
OTP_EXPIRY_MINUTES=10
LOG_LEVEL=info
GOOGLE_MAPS_API_KEY=
APP_URL=http://localhost:3000
