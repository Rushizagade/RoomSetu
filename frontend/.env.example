# ── Google Maps Platform ──────────────────────
# Required for Maps JS API, Places Autocomplete
VITE_GOOGLE_MAPS_API_KEY=

# ── API Base URL ──────────────────────────────
# In development the Vite proxy forwards /api → localhost:3000
# In production set this to your backend's public URL
VITE_API_URL=https://roomsetu-backend.onrender.com

